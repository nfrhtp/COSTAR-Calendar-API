{
  "openapi": "3.1.0",
  "info": {
    "title": "COSTAR Calendar API",
    "version": "1.1.0",
    "summary": "Read-only JSON access to the COSTAR calendar, 2000–2051.",
    "description": "Daily COSTAR date strings, lumas, chromas, lunations, lunar phases, and solar events, served from a pregenerated golden dataset. No authentication. All dates are Pacific Time days (the calendar's native zone). Field semantics: https://api.costar.date/reference.html",
    "contact": { "url": "https://github.com/nfrhtp/COSTAR-Calendar-API" },
    "license": { "name": "CC BY 4.0", "identifier": "CC-BY-4.0" }
  },
  "servers": [{ "url": "https://api.costar.date" }],
  "paths": {
    "/v1/today": {
      "get": {
        "operationId": "getToday",
        "summary": "Today's day object, resolved in Pacific Time",
        "parameters": [{ "$ref": "#/components/parameters/raw" }],
        "responses": {
          "200": { "$ref": "#/components/responses/Day" }
        }
      }
    },
    "/v1/day/{date}": {
      "get": {
        "operationId": "getDay",
        "summary": "One day by ISO Gregorian date",
        "parameters": [
          { "name": "date", "in": "path", "required": true, "schema": { "type": "string", "format": "date", "examples": ["2026-07-21"] } },
          { "$ref": "#/components/parameters/raw" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Day" },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/range/{start}/{end}": {
      "get": {
        "operationId": "getRange",
        "summary": "Consecutive days, inclusive (max 400)",
        "parameters": [
          { "name": "start", "in": "path", "required": true, "schema": { "type": "string", "format": "date" } },
          { "name": "end", "in": "path", "required": true, "schema": { "type": "string", "format": "date" } },
          { "$ref": "#/components/parameters/raw" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Range" },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/month/{month}": {
      "get": {
        "operationId": "getMonth",
        "summary": "A calendar month of days",
        "parameters": [
          { "name": "month", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^\\d{4}-\\d{2}$", "examples": ["2026-07"] } },
          { "$ref": "#/components/parameters/raw" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Range" },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/year/{year}": {
      "get": {
        "operationId": "getYear",
        "summary": "A Gregorian year of days",
        "parameters": [
          { "$ref": "#/components/parameters/year" },
          { "$ref": "#/components/parameters/raw" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Range" },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/events/phases/{year}": {
      "get": {
        "operationId": "getPhaseEvents",
        "summary": "Lunar phase events for a year",
        "parameters": [{ "$ref": "#/components/parameters/year" }],
        "responses": {
          "200": {
            "description": "Phase events",
            "content": { "application/json": { "schema": {
              "type": "object",
              "properties": {
                "kind": { "const": "phases" },
                "year": { "type": "integer" },
                "events": { "type": "array", "items": { "$ref": "#/components/schemas/PhaseIndexEvent" } },
                "meta": { "$ref": "#/components/schemas/MetaStamp" }
              } } } }
          },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/events/solar-terms/{year}": {
      "get": {
        "operationId": "getSolarTermEvents",
        "summary": "The 12 major solar terms for a year (incl. solstices and equinoxes)",
        "parameters": [{ "$ref": "#/components/parameters/year" }],
        "responses": {
          "200": {
            "description": "Solar term events",
            "content": { "application/json": { "schema": {
              "type": "object",
              "properties": {
                "kind": { "const": "solar-terms" },
                "year": { "type": "integer" },
                "events": { "type": "array", "items": { "$ref": "#/components/schemas/SolarIndexEvent" } },
                "meta": { "$ref": "#/components/schemas/MetaStamp" }
              } } } }
          },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/events/lunations/{year}": {
      "get": {
        "operationId": "getLunationEvents",
        "summary": "Lunation starts (new moons) for a year",
        "parameters": [{ "$ref": "#/components/parameters/year" }],
        "responses": {
          "200": {
            "description": "Lunation starts",
            "content": { "application/json": { "schema": {
              "type": "object",
              "properties": {
                "kind": { "const": "lunations" },
                "year": { "type": "integer" },
                "events": { "type": "array", "items": { "$ref": "#/components/schemas/LunationIndexEvent" } },
                "meta": { "$ref": "#/components/schemas/MetaStamp" }
              } } } }
          },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/events/shen": {
      "get": {
        "operationId": "getShen",
        "summary": "Every Shen lunation and Shen week in the dataset",
        "responses": {
          "200": {
            "description": "Shen occurrences",
            "content": { "application/json": { "schema": {
              "type": "object",
              "properties": {
                "lunations": { "type": "array", "items": { "type": "object", "properties": {
                  "date": { "type": "string", "format": "date" },
                  "lunationNumber": { "type": "integer" },
                  "costarDate": { "type": "string" } } } },
                "weeks": { "type": "array", "items": { "type": "object", "properties": {
                  "startSunday": { "type": "string", "format": "date" },
                  "costarDate": { "type": "string" } } } },
                "meta": { "$ref": "#/components/schemas/MetaStamp" }
              } } } }
          }
        }
      }
    },
    "/v1/next/{kind}": {
      "get": {
        "operationId": "getNext",
        "summary": "The next occurrence(s) of a kind of day, on or after a date",
        "description": "Selects, from the pregenerated data, the next `count` days of the given kind whose date is on or after `from` (default: today in Pacific Time). Each result is the full day object exactly as /v1/day/{date} returns it. Kinds: triple-luma (a Triple, Quadruple, or Quintuple luma special — specials.luma tells which), full-moon, new-moon (also the start of a lunation — lunationStarting names it), shen-week (the Sunday starting a Shen week), shen-lunation (the new-moon day starting a Shen lunation), solar-event (a solstice or equinox day, not the cross-quarter terms), spiral-year (the Southern Solstice day on which the spiral year turns; its costar values already belong to the new year). When fewer than `count` remain in coverage the response is flagged clipped.",
        "parameters": [
          { "name": "kind", "in": "path", "required": true, "schema": { "type": "string", "enum": ["triple-luma", "full-moon", "new-moon", "shen-week", "shen-lunation", "solar-event", "spiral-year"] } },
          { "name": "from", "in": "query", "required": false, "schema": { "type": "string", "format": "date" }, "description": "Earliest date to consider, inclusive. Default: today, Pacific Time." },
          { "name": "count", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 10, "default": 1 }, "description": "How many occurrences to return (1–10)." }
        ],
        "responses": {
          "200": {
            "description": "Next occurrences, in date order",
            "content": { "application/json": { "schema": {
              "type": "object",
              "properties": {
                "kind": { "type": "string" },
                "from": { "type": "string", "format": "date" },
                "count": { "type": "integer", "description": "Number of results returned" },
                "clipped": { "type": "boolean", "description": "Present (true) only when fewer than the requested count remain in coverage" },
                "results": { "type": "array", "items": { "$ref": "#/components/schemas/Day" } },
                "meta": { "$ref": "#/components/schemas/MetaStamp" }
              } } } }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/costar/{rotundum}/{spiralYear}/{lunation}/{weekLuma}/{dayChroma}": {
      "get": {
        "operationId": "reverseLookup",
        "summary": "COSTAR date → Gregorian date(s)",
        "description": "Matches resolved (CD) values, which are single-valued every day: lunation is White or Black (never White/Black), week luma is Epsilon or Alpha (never Epsilon/Alpha), Sunday's chroma is Black. Case-insensitive.",
        "parameters": [
          { "name": "rotundum", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[Rr]-?\\d+$", "examples": ["R1"] } },
          { "name": "spiralYear", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[Ss][Yy]\\d+$", "examples": ["SY1"] } },
          { "name": "lunation", "in": "path", "required": true, "schema": { "type": "string", "enum": ["White", "Black", "Alpha", "Green", "Beta", "Yellow", "Orange", "Gamma", "Red", "Delta", "Blue", "Epsilon", "Purple", "Shen"] } },
          { "name": "weekLuma", "in": "path", "required": true, "schema": { "type": "string", "enum": ["Alpha", "Beta", "Gamma", "Delta", "Epsilon", "Shen"] } },
          { "name": "dayChroma", "in": "path", "required": true, "schema": { "type": "string", "enum": ["Black", "Green", "Yellow", "Orange", "Red", "Blue", "Purple"] } }
        ],
        "responses": {
          "200": {
            "description": "Matching dates",
            "content": { "application/json": { "schema": {
              "type": "object",
              "properties": {
                "costarDate": { "type": "string" },
                "count": { "type": "integer" },
                "dates": { "type": "array", "items": { "type": "string", "format": "date" } },
                "meta": { "$ref": "#/components/schemas/MetaStamp" }
              } } } }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/dataset.csv": {
      "get": {
        "operationId": "getDatasetCsv",
        "summary": "Full dataset, verbatim golden CSV (41 columns, one row per day)",
        "responses": { "200": { "description": "CSV file", "content": { "text/csv": {} } } }
      }
    },
    "/v1/dataset.json": {
      "get": {
        "operationId": "getDatasetJson",
        "summary": "Full dataset as structured day objects, in date order",
        "responses": {
          "200": { "description": "All days", "content": { "application/json": { "schema": {
            "type": "object",
            "properties": { "days": { "type": "array", "items": { "$ref": "#/components/schemas/Day" } } }
          } } } }
        }
      }
    },
    "/v1/meta": {
      "get": {
        "operationId": "getMeta",
        "summary": "Coverage, dataset version, source checksum",
        "responses": {
          "200": { "description": "Dataset metadata", "content": { "application/json": { "schema": {
            "type": "object",
            "properties": {
              "apiVersion": { "type": "string" },
              "datasetVersion": { "type": "string" },
              "sourceCsv": { "type": "string" },
              "sourceSha256": { "type": "string" },
              "coverage": { "type": "object", "properties": {
                "start": { "type": "string", "format": "date" },
                "end": { "type": "string", "format": "date" } } },
              "dayCount": { "type": "integer" },
              "builtAt": { "type": "string", "format": "date-time" },
              "docs": { "type": "string" },
              "license": { "type": "string" }
            }
          } } } }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "raw": {
        "name": "raw", "in": "query", "required": false,
        "schema": { "type": "string", "enum": ["1"] },
        "description": "Set raw=1 to receive the 41 golden-CSV columns verbatim (as {date, columns}) instead of the structured day object."
      },
      "year": {
        "name": "year", "in": "path", "required": true,
        "schema": { "type": "string", "pattern": "^\\d{4}$", "examples": ["2026"] }
      }
    },
    "responses": {
      "Day": {
        "description": "A day (structured; or {date, columns} when raw=1)",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Day" } } }
      },
      "Range": {
        "description": "Consecutive days (clipped to dataset coverage when needed)",
        "content": { "application/json": { "schema": {
          "type": "object",
          "properties": {
            "start": { "type": "string", "format": "date" },
            "end": { "type": "string", "format": "date" },
            "count": { "type": "integer" },
            "clipped": { "type": "boolean" },
            "days": { "type": "array", "items": { "$ref": "#/components/schemas/Day" } },
            "meta": { "$ref": "#/components/schemas/MetaStamp" }
          } } } }
      },
      "Error": {
        "description": "Error",
        "content": { "application/json": { "schema": {
          "type": "object",
          "properties": {
            "error": { "type": "string" },
            "hint": { "type": "string" },
            "docs": { "type": "string" }
          } } } }
      }
    },
    "schemas": {
      "MetaStamp": {
        "type": "object",
        "description": "Stamped on every response; datasetVersion changes whenever an adjudication changes the data.",
        "properties": {
          "apiVersion": { "type": "string" },
          "datasetVersion": { "type": "string" },
          "docs": { "type": "string" }
        }
      },
      "UtcInstant": {
        "type": ["object", "null"],
        "description": "The same instant reckoned in UTC (may be a different date than the Pacific-Time day).",
        "properties": {
          "weekday": { "type": "string", "description": "Abbreviated, e.g. Tue" },
          "date": { "type": "string", "format": "date" },
          "time": { "type": "string", "description": "HH:MM, 24-hour" }
        }
      },
      "PhaseIndexEvent": {
        "type": "object",
        "properties": {
          "date": { "type": "string", "format": "date" },
          "name": { "type": "string", "enum": ["New Moon", "First Quarter", "Full Moon", "Last Quarter"] },
          "number": { "type": "integer", "minimum": 1, "maximum": 4 },
          "timePT": { "type": "string" },
          "utc": { "$ref": "#/components/schemas/UtcInstant" },
          "costarDate": { "type": "string" },
          "lunationNumber": { "type": "integer" }
        }
      },
      "SolarIndexEvent": {
        "type": "object",
        "properties": {
          "date": { "type": "string", "format": "date" },
          "term": { "type": "integer", "description": "Sun's celestial longitude: 0, 30, … 330" },
          "event": { "type": ["string", "null"], "description": "Solstice/equinox name, or null for cross-quarter terms" },
          "timePT": { "type": "string" },
          "utc": { "$ref": "#/components/schemas/UtcInstant" },
          "costarDate": { "type": "string" }
        }
      },
      "LunationIndexEvent": {
        "type": "object",
        "properties": {
          "date": { "type": "string", "format": "date" },
          "lunation": { "type": "string" },
          "timePT": { "type": ["string", "null"] },
          "lunationNumber": { "type": "integer" },
          "brownLunation": { "type": "integer" },
          "costarDate": { "type": "string" }
        }
      },
      "Day": {
        "type": "object",
        "description": "One Pacific-Time day. Full field semantics: https://api.costar.date/reference.html",
        "properties": {
          "date": { "type": "string", "format": "date" },
          "costarDate": { "type": "string", "description": "R{rotundum} SY{spiralYear} {lunation} {weekLuma} {dayChroma}, resolved values" },
          "costar": {
            "type": "object",
            "description": "Resolved (CD) calendar position — single-valued",
            "properties": {
              "rotundum": { "type": "integer" },
              "qLuma": { "type": "string" },
              "spiralYear": { "type": "integer", "minimum": 1, "maximum": 25 },
              "syLuma": { "type": "string", "description": "May be the single dual value \"Epsilon/Alpha\"" },
              "lunation": { "type": "string" },
              "weekLuma": { "type": "string" },
              "dayChroma": { "type": "string" },
              "nightLuma": { "type": ["string", "null"] },
              "weekNumber": { "type": "integer" },
              "weekdayNumber": { "type": "integer", "minimum": 1, "maximum": 7 }
            }
          },
          "transitions": {
            "type": "object",
            "description": "Traditional slash notation, verbatim strings",
            "properties": {
              "rotundum": { "type": "string" },
              "qLuma": { "type": "string" },
              "sy": { "type": "string" },
              "syLuma": { "type": "string" },
              "lunation": { "type": "string" },
              "weekLuma": { "type": "string" },
              "dayChroma": { "type": "string" }
            }
          },
          "specials": {
            "type": "object",
            "properties": {
              "chroma": { "type": ["string", "null"] },
              "luma": { "type": ["string", "null"] }
            }
          },
          "lunationStarting": { "type": ["string", "null"] },
          "phase": {
            "type": "object",
            "properties": {
              "dayNumber": { "type": "integer", "description": "Days since last new moon; 0 on new-moon days" },
              "brownLunation": { "type": "integer" },
              "lunationNumber": { "type": "integer" },
              "event": {
                "type": ["object", "null"],
                "properties": {
                  "name": { "type": "string" },
                  "number": { "type": "integer" },
                  "timePT": { "type": "string" },
                  "utc": { "$ref": "#/components/schemas/UtcInstant" }
                }
              }
            }
          },
          "solar": {
            "type": ["object", "null"],
            "properties": {
              "term": { "type": "integer" },
              "event": { "type": ["string", "null"] },
              "timePT": { "type": "string" },
              "utc": { "$ref": "#/components/schemas/UtcInstant" }
            }
          },
          "gregorian": {
            "type": "object",
            "properties": {
              "weekday": { "type": "string" },
              "displayDate": { "type": "string" },
              "dayOfYear": { "type": "integer" },
              "julian": { "type": "number" },
              "timezone": { "type": "string", "enum": ["PST", "PDT"] }
            }
          },
          "meta": { "$ref": "#/components/schemas/MetaStamp" }
        }
      }
    }
  }
}
